<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Flowlight Filter</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<!-- The extension's version is pinned here, on its OWN lifecycle, NOT $(MARKETING_VERSION). macOS runs one
	     content filter at a time and holds superseded copies until a restart, so changing the extension's version
	     on every app release forced a reboot each time. Kept fixed, an app-only update ships the version macOS
	     already runs and replaces nothing. Bump these two ONLY when the FlowlightExtension binary itself changes
	     (and expect one replacement when you do). Kept at the 0.10.1 values so upgrades from 0.10.1 need no reboot. -->
	<key>CFBundleShortVersionString</key>
	<string>0.10.1</string>
	<key>CFBundleVersion</key>
	<string>22</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>FLAppGroupIdentifier</key>
	<string>$(TeamIdentifierPrefix)com.flowlight.shared</string>
	<key>NSSystemExtensionUsageDescription</key>
	<string>Flowlight uses a network filter extension to attribute every connection to the app that made it. It records only metadata, never blocks traffic, and nothing leaves your Mac.</string>
	<key>NetworkExtension</key>
	<dict>
		<key>NEMachServiceName</key>
		<string>$(TeamIdentifierPrefix)com.flowlight.shared.xpc</string>
		<key>NEProviderClasses</key>
		<dict>
			<key>com.apple.networkextension.filter-data</key>
			<string>$(PRODUCT_MODULE_NAME).FilterDataProvider</string>
		</dict>
	</dict>
</dict>
</plist>
