# Build output
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.pkg
*.dmg

# Generated by XcodeGen (regenerate with `xcodegen generate`). The shared project
# and schemes stay committed because Xcode Cloud must discover its selected
# container before any post-clone script can run. Local and Xcode-managed state
# remains ignored.
Flowlight.xcodeproj/*
!Flowlight.xcodeproj/project.pbxproj
!Flowlight.xcodeproj/project.xcworkspace/
Flowlight.xcodeproj/project.xcworkspace/*
!Flowlight.xcodeproj/project.xcworkspace/contents.xcworkspacedata
!Flowlight.xcodeproj/xcshareddata/
Flowlight.xcodeproj/xcshareddata/*
!Flowlight.xcodeproj/xcshareddata/xcschemes/
!Flowlight.xcodeproj/xcshareddata/xcschemes/*.xcscheme

# Signing material. Never commit any of this, however briefly it lives here.
certs/
*.p12
*.pfx
*.p8
*.pem
# The app's purpose-scoped verification key is public data, not signing authority.
!Flowlight/Resources/RulePacks/official-rule-packs-v1-public.pem
*.key
*.cer
*.provisionprofile
*.mobileprovision

# macOS
.DS_Store

# Working directory for design proofs and one-off scripts.
scratchpad/

# Python bytecode from the scripts in this folder.
__pycache__/
*.pyc
