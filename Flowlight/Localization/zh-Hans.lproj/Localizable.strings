/* UI/CaptureView.swift */
"Delete all recorded traffic, baselines and alerts?" = "删除所有已记录的流量、基线和警报？";
"Delete everything" = "全部删除";
"nettop sampler · the extension didn't answer" = "nettop 采样器 · 扩展没有响应";
